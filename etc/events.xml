<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Global scope (not adminhtml/etc) - must also catch programmatic saves from CLI/API/custom
         importers, not just admin panel edits. -->
    <event name="catalog_product_save_after">
        <observer name="bydn_solosearch_product_save_after" instance="Bydn\SoloSearch\Observer\ProductSaveAfter"/>
    </event>
    <event name="catalog_product_delete_after">
        <observer name="bydn_solosearch_product_delete_after" instance="Bydn\SoloSearch\Observer\ProductDeleteAfter"/>
    </event>
    <!-- Admin grid "Update Attributes" mass action - a bulk SQL update, not a per-product save,
         so it needs its own observer (see Observer\ProductAttributeMassUpdate docblock). -->
    <event name="catalog_product_attribute_update_before">
        <observer name="bydn_solosearch_product_attribute_mass_update" instance="Bydn\SoloSearch\Observer\ProductAttributeMassUpdate"/>
    </event>
</config>
