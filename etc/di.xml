<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Product queue (pending single-product updates/deletes for the real-time sync) -->
    <preference for="Bydn\SoloSearch\Api\Data\ProductQueueItemInterface" type="Bydn\SoloSearch\Model\ProductQueueItem"/>
    <preference for="Bydn\SoloSearch\Api\ProductQueueItemRepositoryInterface" type="Bydn\SoloSearch\Model\ProductQueueItemRepository"/>

    <!-- Console command -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="solosearchFeedGenerate" xsi:type="object">Bydn\SoloSearch\Console\Command\GenerateFeedCommand</item>
            </argument>
        </arguments>
    </type>

    <!-- LOG bydn_solosearch.log (definition) -->
    <virtualType name="Bydn\SoloSearch\Logger\Handler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/bydn_solosearch.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="Bydn\SoloSearch\Logger\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">bydn_solosearch</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Bydn\SoloSearch\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- LOG bydn_solosearch.log (usages) -->
    <type name="Bydn\SoloSearch\Console\Command\GenerateFeedCommand">
        <arguments>
            <argument name="logger" xsi:type="object">Bydn\SoloSearch\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Bydn\SoloSearch\Cron\GenerateFeed">
        <arguments>
            <argument name="logger" xsi:type="object">Bydn\SoloSearch\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Bydn\SoloSearch\Model\FeedGenerator">
        <arguments>
            <argument name="logger" xsi:type="object">Bydn\SoloSearch\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Bydn\SoloSearch\Model\SoloSearchClient">
        <arguments>
            <argument name="logger" xsi:type="object">Bydn\SoloSearch\Logger\Logger</argument>
        </arguments>
    </type>

</config>
